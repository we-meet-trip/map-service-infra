# 운영 관리 API(docker-compose.admin.prod.yml 의 admin) 런타임 입력 본보기.
# 실제 파일은 운영 VM 의 비공개 경로(root 0600)에 두고 compose 입력
# ADMIN_RUNTIME_ENV_FILE 로 가리킨다. 한 줄에 KEY=value 하나, 따옴표·변수 확장·
# 줄 끝 주석을 쓰지 않는다(format: raw 라 글자 그대로 들어간다. Compose v2.30.0 이상).
#
# control 은 관리 콘솔 자신의 이름이다. 대상 목록에는 없으므로 처음 열면 조회가
# 400 으로 보인다. 화면 상단 '대상 환경'에서 prod 를 골라 조회하고, 운영자 계정
# 관리는 control 을 고른 상태에서만 된다.
ADMIN_ENVIRONMENT=control
# map_admin_runtime 계정. 비밀번호의 예약 문자는 퍼센트 인코딩한다.
#   postgresql+psycopg://map_admin_runtime:<비밀번호>@admin-control-db:5432/admin_control
ADMIN_CONTROL_DATABASE_URL=
ADMIN_RUN_MIGRATIONS=false
# 대상은 prod 하나. 세 토큰은 운영 서비스 런타임 값과 같아야 하고 서로 달라야 한다.
# user·hub 는 호출 주소가 신뢰 대역(USER_/HUB_INTERNAL_TRUSTED_CIDRS) 안일 때만
# 관리 호출을 받으므로, map-prod-net 대역이 그 안에 들어 있어야 한다.
# 대상 DB·Redis 진단은 두지 않는다(빈 값).
ADMIN_TARGETS={"prod":{"USER_BASE_URL":"http://user:8080","AGENT_BASE_URL":"http://agent:8000","HUB_BASE_URL":"http://hub:8000","INTERNAL_SERVICE_TOKEN":"","USER_ADMIN_INTERNAL_TOKEN":"","HUB_ADMIN_INTERNAL_TOKEN":"","ADMIN_DATABASE_URL":"","ADMIN_REDIS_URL":""}}
# 계정 저장소가 비어 있을 때만 읽힌다. 비어 있는 저장소에서 이 두 값까지 비어
# 있으면 관리 API 는 기동 단계에서 멈추고 재시작을 되풀이한다.
# 첫 owner 는 한 번만 시드한다: 두 값을 잠시 채운다(비밀번호 12자 이상, 72바이트
# 이하) → up -d --wait admin 으로 기동해 /health/ready 200 을 확인한다 → 두 값을
# 다시 비운다 → up -d admin admin-web 으로 다시 만든다.
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_PASSWORD=
