# docker-compose.admin.prod.yml 렌더 입력 본보기(--env-file). 비밀값은 넣지 않는다.
# 런타임·1회 작업 env 파일은 format: raw 로 읽으므로 Docker Compose v2.30.0 이상이 필요하다.
#
# 이미지는 서비스 스택과 같은 릴리스 묶음에서 image@digest 로 옮긴다. 원천은
# release.json 이고 compose.admin-images.yml 에도 같은 값이 있다.
#   jq -r '.services.admin.image + "@" + .services.admin.digest' release.json
#   jq -r '.services["admin-web"].image + "@" + .services["admin-web"].digest' release.json
#   ADMIN_API_IMAGE      ghcr.io/we-meet-trip/map-service-admin@sha256:...
#   ADMIN_WEB_IMAGE      ghcr.io/we-meet-trip/map-service-admin-web@sha256:...
ADMIN_API_IMAGE=
ADMIN_WEB_IMAGE=
# 검토한 PostgreSQL 이미지의 linux/amd64 manifest digest.
ADMIN_CONTROL_POSTGRES_IMAGE=
# 비공개 파일 경로(root 0600). 예: /srv/map-prod/secrets/admin-runtime.env
ADMIN_RUNTIME_ENV_FILE=
# 예: /srv/map-prod/secrets/admin-migration.env (1회 작업 뒤 지워도 평소 기동은 된다)
ADMIN_MIGRATION_ENV_FILE=
# control DB 관리자(admin_provisioner) 비밀번호 한 줄. 예: /srv/map-prod/secrets/admin-control-provisioner-password
ADMIN_CONTROL_PROVISIONER_PASSWORD_FILE=
# 미리 만든 빈 디렉터리. 예: /srv/map-prod/data/admin-control-db
ADMIN_CONTROL_DATA_DIR=
