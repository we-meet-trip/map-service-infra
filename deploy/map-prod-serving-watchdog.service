[Unit]
Description=MAP NCP production public serving watchdog
After=network-online.target docker.service map-prod-serving.service
Wants=network-online.target
RequiresMountsFor=/srv/map-prod
ConditionPathExists=/srv/map-prod/deploy/serving-state.json
ConditionPathExists=/opt/map-serving-controller/scripts/ncp-production-serving.py

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/map-service-infra
ExecStart=/usr/bin/python3 -B /usr/local/lib/map-serving/ncp-serving-watchdog.py
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/empty
Environment=DOCKER_HOST=unix:///var/run/docker.sock
Environment=DOCKER_CONFIG=/var/empty
TimeoutStartSec=300
TimeoutStopSec=10
KillMode=control-group
SendSIGKILL=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/map-prod /var/run/docker.sock
PrivateTmp=yes
