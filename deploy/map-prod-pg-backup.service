[Unit]
Description=MAP NCP production pg encrypted backup
After=network-online.target docker.service
Wants=network-online.target
RequiresMountsFor=/srv/map-prod
ConditionPathExists=/var/lib/map-bootstrap/enrollment.json
ConditionPathExists=/srv/map-prod/secrets/backup.json

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/map-service-infra
ExecStart=/usr/bin/python3 -B /opt/map-service-infra/scripts/ncp-production-backup.py pg
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/empty
Environment=DOCKER_HOST=unix:///var/run/docker.sock
Environment=DOCKER_CONFIG=/var/empty
TimeoutStartSec=900
TimeoutStopSec=10
KillMode=control-group
SendSIGKILL=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/map-prod /var/run/docker.sock
PrivateTmp=yes
