[Unit]
Description=MAP GCP test Redis RDB backup with off-host checksum and isolated restore
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/map-deploy/backup-test-redis-service.py
TimeoutStartSec=600
KillMode=control-group
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
