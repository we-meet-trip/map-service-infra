# 바깥에서 들어오는 자리. 인증서는 이 서버가 직접 받아 갱신한다.
#
# 관문 앞에 한 겹을 더 두는 것은 https 때문이다. 관문은 평문으로만 받고,
# 경로 허용목록·요청 상한·소켓 업그레이드를 이미 다룬다. 그 판단을 여기로
# 옮기지 않는다 — 두 곳에 나뉘면 어느 쪽이 막았는지 알기 어려워진다.

# 인증서 만료가 다가오면 발급처가 이 주소로 알린다. 늘 켜 두는 서버라
# 갱신이 막혔을 때 알아차릴 길이 이것뿐이다.
{
	email {$EDGE_EMAIL}
}

{$EDGE_DOMAIN} {
	# 관문이 실제 요청자 주소를 이 헤더에서 읽는다. 채우지 않으면 모든 요청이
	# 이 앞단의 주소 하나로 보여, 분당 상한이 사용자별이 아니라 전체 하나로
	# 걸린다. 한 사람이 채우면 나머지 전원이 함께 막힌다.
	#
	# 요청자가 보낸 같은 이름의 헤더는 먼저 지운다. 지우지 않으면 상한을
	# 피하려고 아무 값이나 적어 보낼 수 있다.
	reverse_proxy proxy:80 {
		header_up -CF-Connecting-IP
		header_up CF-Connecting-IP {remote_host}

		# 일정 생성은 모델을 기다리느라 오래 걸린다. 앞단이 먼저 끊으면
		# 서버가 준비한 시간초과 안내가 사용자에게 닿지 못하고 사유 없는
		# 실패가 된다. 관문의 대기 상한보다 넉넉히 잡는다.
		transport http {
			response_header_timeout 320s
			read_timeout 320s
		}
	}
}
