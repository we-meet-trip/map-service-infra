# map-service-infra — .env 템플릿. 실제 값은 `.env`에 채우고 절대 commit 하지 않는다.

# (1) PostgreSQL
POSTGRES_DB=map
POSTGRES_USER=map
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# (2) Redis (단일 인스턴스, DB 번호로 용도 분리 — 코드 RedisConfig 기준)
# DB0=기본/세션 / DB1=JWT 블랙리스트 / DB2=Streams / DB3=rate-limit+카운터 / DB4=초안(draft) / DB5=채팅
# (채팅 발행/구독 채널은 논리 DB 무관하게 동작하며, DB5 는 채팅 전용 연결에 할당된 값)
REDIS_HOST=redis
REDIS_PORT=6379
# 비우면 무인증(현행)
REDIS_PASSWORD=

# (3) 내부 서비스 인증·라우팅 (D1 — info → hub 통일)
INTERNAL_SERVICE_TOKEN=replace-with-32-chars-or-more
AGENT_HOST=agent
AGENT_BASE_URL=http://agent:8000
HUB_HOST=hub
HUB_BASE_URL=http://hub:8000
USER_HOST=user
USER_BASE_URL=http://user:8080

# (4) JWT (user 전용) — user 서비스 서명 알고리즘은 RS256
# JWT_SECRET: deprecated — user 서비스는 RS256 사용, JWT_PRIVATE_KEY/JWT_PUBLIC_KEY 참조
JWT_SECRET=replace-with-32-chars-or-more
# RS256 개인키 (PKCS8 Base64)
JWT_PRIVATE_KEY=
# RS256 공개키 (X509 Base64)
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# (5) 외부 API 키
# Kakao 로그인(OAuth): CLIENT_ID=REST API 키. 브라우저 코드플로우이므로 REDIRECT_URI 는
# 반드시 Kakao 콘솔에 등록한 https 백엔드 콜백과 byte 단위로 동일해야 한다(커스텀 스킴 불가).
# 예: https://<배포도메인>/api/v1/auth/kakao/callback (로컬 기본값 http://localhost:8080/... 은 실기기 미도달).
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=
# authorize 엔드포인트/앱 복귀 스킴(선택 — 미설정 시 아래 기본값 사용).
# APP_CALLBACK_SCHEME 의 스킴은 Flutter AndroidManifest CallbackActivity 스킴(mapauth)과 일치해야 한다.
KAKAO_AUTHORIZE_URI=https://kauth.kakao.com/oauth/authorize
KAKAO_APP_CALLBACK_SCHEME=mapauth://kakao
KAKAO_REST_API_KEY=
KAKAO_MAPS_JS_KEY=
KMA_SERVICE_KEY=
TOUR_API_SERVICE_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# (5b) 경로 라우팅 (자체 호스팅 OSRM)
# 도보(foot)/자전거(bicycle) 프로파일 OSRM 인스턴스의 base URL.
# 비워 두면 hub 가 결정적 스텁 지오메트리로 폴백한다(데이터 빌드 전 검증용).
# scripts/osrm-rebuild.sh 로 데이터를 빌드하고
# `docker compose --profile routing up -d` 로 기동한 뒤 아래를 채우고 hub 재기동:
#   OSRM_FOOT_BASE_URL=http://osrm-foot:5000
#   OSRM_BICYCLE_BASE_URL=http://osrm-bicycle:5000
OSRM_FOOT_BASE_URL=
OSRM_BICYCLE_BASE_URL=

# (6) 모드·메타
LANGGRAPH_SCHEMA=langgraph
DEMO_FORCE_CACHE=false

# (8) admin 운영 모니터링 (cut 1: 읽기전용)
# MAP_ADMIN_PASSWORD 는 db/init/10-admin.sh 의 map_admin 역할 비밀번호이며,
# ADMIN_DATABASE_URL 의 비밀번호와 반드시 동일해야 한다(단일 출처).
MAP_ADMIN_PASSWORD=replace-with-map-admin-password
ADMIN_DATABASE_URL=postgresql+psycopg://map_admin:replace-with-map-admin-password@postgres:5432/map
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=replace-with-strong-password

# (8.5) 채팅 (경계 B8) — 상세 설정은 application.yml chat.* 기본값 사용
# CHAT_INVITE_BASE_URL: 초대 링크 기준 주소. 기본값은 비라우팅 placeholder 이므로
#                       배포 시 실제 딥링크 주소로 반드시 오버라이드해야 한다.
CHAT_INVITE_BASE_URL=https://example.invalid/chat/invite/
# CHAT_MAX_MESSAGE_LENGTH: 텍스트 메시지 최대 글자 수(초과 시 400 거부)
CHAT_MAX_MESSAGE_LENGTH=2000

# (9) 보안 (CORS / 인증 강제)
# CORS_ALLOWED_ORIGINS: 운영 시 명시 도메인으로 제한
CORS_ALLOWED_ORIGINS=*
AUTH_ENFORCED=false
