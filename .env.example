# map-service-infra — .env 템플릿. 실제 값은 `.env`에 채우고 절대 commit 하지 않는다.

# (1) PostgreSQL
POSTGRES_DB=map
POSTGRES_USER=map
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# hub 는 이 값을 기본값 없이 필수로 읽는다. 비어 있으면 설정 검증에서 걸려
# 컨테이너가 부팅하지 못하므로, 템플릿을 복사한 직후에도 바로 뜨도록 넣어 둔다.
# 드라이버 이름(psycopg)을 바꾸지 않는다. 다른 이름을 적으면 hub 는 그대로
# 뜨고 상태 확인도 정상으로 나오는데, 예약해 둔 수집 작업만 조용히 실패한다.
# Serving connects as the restricted runtime role, which cannot create objects.
# The migrator DSN lives in the root-owned /etc/map-deploy/hub-migration.env.
HUB_DATABASE_URL=postgresql+psycopg://map_hub_runtime:replace-with-a-distinct-hub-runtime-password@postgres:5432/map

# 외부 발급처 호출을 전부 결정적 스텁으로 대체한다. 시험 스택 전용 스위치이며
# 운영에서는 비워 둔다. 키가 비어 있을 때도 스텁으로 떨어지는데, 그 경우와
# 의도적으로 끈 경우가 로그에서 구분되지 않으므로 시험 스택은 이 값을 명시한다.
PLACES_STUB_MODE=
# 저장 본문 암호화. 일정과 추천 결과 본문에는 사용자가 어디를 다니는지가 좌표와
# 함께 들어 있어, 저장소 파일이나 백업이 통째로 빠져나가면 그대로 읽힌다.
# 켜 두었는데 키가 없으면 BFF 가 부팅하지 않는다 — 켠 줄 알고 평문으로 쌓이는
# 상태를 만들지 않기 위해서다.
#
# 키는 32바이트여야 한다. 아래처럼 만든다.
#   openssl rand -base64 32
# 여러 개를 두는 것은 키를 바꾸는 동안 옛 키로 쓴 값을 계속 읽기 위해서다.
# 바꾸는 순서: 새 키를 KEYS 에 먼저 넣어 배포 → 다음 배포에서 ACTIVE_KID 를 옮긴다.
# 한 번에 하면 아직 새 키를 모르는 인스턴스가 그 값을 읽지 못한다.
# 옛 키를 KEYS 에서 지우는 순간 그 키로 쓴 값은 영영 읽을 수 없다.
LOCATION_ENC_ENABLED=true
LOCATION_ENC_ACTIVE_KID=k1
LOCATION_ENC_KEYS=k1:cmVwbGFjZS10aGlzLWtleS1iZWZvcmUtZGVwbG95aW4=
# 서비스 사이로 오가는 좌표를 감싸는 열쇠. BFF 와 hub 가 같은 값을 나눠 가진다.
# 저장에 쓰는 열쇠와 반드시 다른 값으로 둔다 — 하나로 합치면 좌표를 받아 쓰는
# 서비스가 뚫렸을 때 저장된 것까지 함께 열린다.
#
# 32바이트로 풀리는 base64 여야 한다: openssl rand -base64 32
# 이 값이 있으면 hub 는 감싼 좌표만 받는다. 값으로 온 좌표는 거절한다 —
# 못 열었을 때 평문으로 물러서면 감싸는 쪽이 고장 나도 아무도 알아차리지 못한다.
LOCATION_WIRE_ENABLED=true
LOCATION_WIRE_KEY=

# agent 가 대화 상태(체크포인트)를 저장할 때 쓰는 봉인 열쇠. 형식은
# LOCATION_ENC_KEYS 와 같은 "kid:base64" 쉼표 목록이며, 각 값은 32바이트로
# 풀려야 한다(openssl rand -base64 32). 위 열쇠들과 다른 값이어야 한다 —
# LOCATION_WIRE_KEY 와 같으면 agent 가 부팅을 거부한다.
CHECKPOINT_ENC_ACTIVE_KID=k1
CHECKPOINT_ENC_KEYS=k1:changeme-32-byte-base64
# BFF 가 봉투를 열 때 보는 나이 상한(초). 스트림에 밀린 값을 살리려고
# 보내는 쪽 만료(300초)보다 느슨하다. 0 이면 나이를 보지 않는다.
#LOCATION_WIRE_MAX_AGE_SECONDS=3600

# (2) Redis (단일 인스턴스, DB 번호로 용도 분리 — 코드 RedisConfig 기준)
# DB0=기본/세션 / DB1=JWT 블랙리스트 / DB2=Streams / DB3=rate-limit+카운터 /
# DB4=BFF 초안(draft) + hub 외부데이터 캐시(공유) / DB5=채팅 / DB6=BFF 재사용 캐시
# (채팅 발행/구독 채널은 논리 DB 무관하게 동작하며, DB5 는 채팅 전용 연결에 할당된 값)
#
# 접속 정보를 읽는 키가 서비스마다 다르다.
#   REDIS_HOST/REDIS_PORT — user-BFF 전용
#   REDIS_URL             — hub · agent
#   ADMIN_REDIS_URL       — admin (아래 (8.5) 절)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
# 비우면 무인증(현행). 값을 채우면 redis 컨테이너와 user-BFF 에만 적용되므로,
# hub·agent·admin 은 위 URL 들을 redis://:<PW>@redis:6379 형태로 함께 고쳐야 한다.
REDIS_PASSWORD=

# (3) 내부 서비스 인증·라우팅 (D1 — info → hub 통일)
INTERNAL_SERVICE_TOKEN=replace-with-32-chars-or-more
# Admin→User only, distinct per environment. No fallback to the ordinary token.
USER_ADMIN_INTERNAL_TOKEN=replace-with-independent-admin-user-token
# User ordinary Hub requests retain 5s; directions use one 20s budget per <=20-leg batch.
# Agent continues to use HUB_TIMEOUT_SECONDS independently.
USER_HUB_TIMEOUT_SECONDS=5
HUB_DIRECTIONS_TIMEOUT_SECONDS=20
# HUB_INTERNAL_TRUSTED_CIDRS: hub 의 /internal/* 호출을 허용할 대역. 토큰과 함께
#   이중 관문으로 동작하며, 둘 중 하나라도 틀리면 403 이다.
HUB_INTERNAL_TRUSTED_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# BFF 도 같은 규약을 쓴다. 코드가 읽는데 여기 자리가 없었다.
# USER_INTERNAL_TRUSTED_CIDRS: 내부 관리 호출을 받아 줄 대역.
# USER_RATELIMIT_TRUSTED_PROXIES: 요청자 주소를 헤더에서 읽어도 되는 앞단의 대역.
#   여기 없는 곳에서 온 헤더는 믿지 않는다. 루프백이 들어가는 것은 같은 기계의
#   관문을 거쳐 들어오기 때문이다.
USER_INTERNAL_TRUSTED_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
USER_RATELIMIT_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.0/8
# 서비스 사이 호출은 프록시의 내부 창구를 거친다. 상대를 새 판으로 바꾸는
# 동안에도 이 주소는 그대로이고, 프록시가 바뀐 쪽으로 넘긴다. 경로는 이
# 주소 뒤에 / 로 시작해서 붙는다.
AGENT_BASE_URL=http://proxy:8081/agent
HUB_BASE_URL=http://proxy:8081/hub
USER_BASE_URL=http://proxy:8081/user
# 카메라 인식 서비스. 현재 이 주소를 읽는 서버는 없다(클라이언트가 관문의
# /ws/vision 으로 직접 붙고, nginx 는 자기 설정 파일에 주소를 갖고 있다).
# 스택 안에서의 위치를 문서로 남겨 두는 항목이다.

# (4) JWT (user 전용) — user 서비스 서명 알고리즘은 RS256
# AUTH_ENFORCED=false(기본) 이면 두 키가 비어도 부팅한다(임시 키쌍 생성 — 재기동 시 기존
# 토큰 전부 무효). AUTH_ENFORCED=true 로 올리려면 두 키가 반드시 채워져야 하며,
# 비어 있으면 AuthStartupValidator 가 부팅을 중단시킨다.
# RS256 개인키 (PKCS8 Base64, 개행 없이 한 줄)
JWT_PRIVATE_KEY=
# RS256 공개키 (X509 Base64, 개행 없이 한 줄)
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# (5) 외부 API 키
# Kakao 로그인(OAuth): CLIENT_ID=REST API 키. 브라우저 코드플로우이므로 REDIRECT_URI 는
# 반드시 Kakao 콘솔에 등록한 https 백엔드 콜백과 byte 단위로 동일해야 한다(커스텀 스킴 불가).
# 예: https://<배포도메인>/api/v1/auth/kakao/callback (로컬 기본값 http://localhost:8080/... 은 실기기 미도달).
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=
# authorize 엔드포인트/앱 복귀 스킴(선택 — 미설정 시 아래 기본값 사용).
# APP_CALLBACK_SCHEME 의 스킴은 Flutter AndroidManifest CallbackActivity 스킴(mapauth)과 일치해야 한다.
KAKAO_AUTHORIZE_URI=https://kauth.kakao.com/oauth/authorize
KAKAO_APP_CALLBACK_SCHEME=mapauth://kakao
KAKAO_REST_API_KEY=
KMA_SERVICE_KEY=
# AIRKOREA_SERVICE_KEY: 대기질 조회용. 비우면 KMA_SERVICE_KEY 를 대신 쓴다.
#                       별도로 신청한 키가 있으면 여기에 채운다.
AIRKOREA_SERVICE_KEY=
TOUR_API_SERVICE_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NAVER_MAP_CLIENT_ID: 지도 타일 인증에 쓰는 식별자. 위의 NAVER_CLIENT_ID 는
#   검색 API 키라 이름만 비슷하고 서로 대신하지 못한다 — 바꿔 넣으면 지도가
#   인증에서 막힌다.
#   브라우저와 앱이 이 값을 직접 내보내야 지도가 뜨므로 감출 수 없다. 방어는
#   발급처에 등록한 도메인·패키지 목록이 한다.
# NAVER_MAP_CLIENT_ID_FALLBACK: 예비 식별자. 비워 두면 폴백 없이 동작한다.
#   위 값으로 먼저 붙고, 인증이 막히면 이 값으로 한 번 더 시도한다. 발급처가
#   등록 도메인·패키지와 요청이 맞지 않으면 인증을 거절하는데, 그 판정이
#   화면을 열기 전까지 드러나지 않아 잘못된 값이 오래 남기 쉽다.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_ID_FALLBACK=
# GOOGLE_MAPS_API_KEY: 장소 사진 전용(Places API (New)). 비우면 사진만 스텁으로 빠지고
#   화면의 나머지는 그대로 나간다. 사진 주소 발급이 건당 과금이라 하루 상한을 건다.
GOOGLE_MAPS_API_KEY=
GOOGLE_PHOTOS_DAILY_MEDIA_CAP=32
GEMINI_API_KEY=
# ★ gemini-2.5-flash 는 2026-10-16 폐기 예정이다. 그날이 지나면 추천이 통째로
#   멈춘다. 갈아타는 비용은 이 한 줄이 전부다 — 모델명이 코드가 아니라 설정에만
#   있고, agent 와 yolo 모두 같은 키를 읽는다.
#
#   후보를 실제로 돌려 보고 확인한 것(2026-08-22):
#     gemini-flash-latest  별칭이라 폐기일이 없다. 품질은 동등했다(실측 후보로
#                          고르고, 스키마도 지켰다). 다만 응답이 5~13초에서
#                          22초로 늘었다. 첫 호출은 51초였는데 그것은 기동 직후
#                          한 번뿐이다.
#     gemini-3.7-flash     발급처 목록에는 있으나 이 서비스에서 돌려 보지 않았다.
#
#   지금은 빠른 현행을 쓴다. 폐기일이 가까워지거나 시연이 그 뒤라면 별칭으로
#   바꾸고 한 번 돌려 확인하면 된다.
GEMINI_MODEL=gemini-2.5-flash
# 호출 상한 두 가지. 기본값은 무료 등급을 전제로 잡혀 있어, 유료로 올려도
# 여기를 함께 올리지 않으면 늘어난 한도를 쓰지 못한다. agent 가 자기 쪽에서
# 먼저 막기 때문이다.
#
# GEMINI_RPD_CAP: 하루 상한. 발급처 한도보다 낮게 잡아 여유를 남긴다.
#   산식 — 일정 1건이 추천 2회(장소 선정·이유) + 요약 1회 = 3회를 쓴다.
#   하루 N건을 받으려면 N × 3 이 필요하다.
#     하루   100건 →   300
#     하루 2,000건 → 6,000
#   기본 200 은 하루 60여 건까지만 감당한다.
#
# GEMINI_RPM_LIMIT: 분당 상한. 이것이 실질 동시 처리량을 정한다.
#   한 건이 3회를 쓰므로 분당 10 이면 동시에 3건 남짓이 한계다. 넘으면
#   최대 60초 기다린 뒤 실패한다 — 조용히 느려지는 것이 아니라 끊긴다.
#   낮보다 밤에 몰리는 서비스라 하루 평균으로 잡으면 저녁에 막힌다.
#   피크를 평균의 3배 이상으로 보고 여유를 두는 편이 낫다.
GEMINI_RPD_CAP=200
GEMINI_RPM_LIMIT=10
# ODSAY_API_KEY: 지하철 경로 탐색용. 비우면 경로 조회가 고정 스텁으로 빠진다.
#   발급처가 앱 등록마다 URI·서버·Android·iOS 별로 키를 따로 내주는데, 요청에는
#   어느 쪽인지 실리지 않아 어떤 키를 넣어도 서버에서 호출된다. 등록해 둔 쓰임에
#   맞추려면 서버용 키를 받아 채운다.
#   무료 등급의 하루 호출 수가 적어 hub 가 좌표 단위로 캐시하고 하루 상한을 건다.
ODSAY_API_KEY=
# ODSAY_API_KEY_FALLBACK: 예비 키. 비워 두면 폴백 없이 동작한다.
#   발급처는 등록해 둔 쓰임과 요청이 맞지 않으면 키 인증 자체를 거절한다.
#   콘솔에서 플랫폼 키를 정리하거나 등록 정보를 바꾸는 순간 한쪽이 막힐 수
#   있어, 그때 기능이 통째로 죽는 대신 다른 키로 한 번 더 시도하게 한다.
#   키에 얽힌 실패에만 다시 부르며, 그 호출도 하루 상한을 함께 쓴다.
ODSAY_API_KEY_FALLBACK=
ODSAY_DAILY_CALL_CAP=900
# SEOUL_OPENAPI_KEY: 서울 열린데이터광장 인증키. 지금은 따릉이 대여소 현황에 쓴다.
#   비우면 대여소 목록이 고정 스텁으로 빠진다. 발급처가 https 를 받지 않아
#   hub 에서 나가는 이 호출만 평문이다 — 그래서 앱이 직접 부르지 않는다.
#   전체 목록이 한 번에 오지 않아 나눠 받은 뒤 통째로 캐시하고, 요청한 좌표
#   주변만 잘라서 돌려준다. 캐시가 짧을수록 하루 호출 수가 비례해 늘어난다.
SEOUL_OPENAPI_KEY=
SEOUL_BIKE_CACHE_TTL_SEC=300
# PM_SERVICE_KEY: 공유 킥보드(국토교통부 퍼스널모빌리티) 조회용 data.go.kr 키.
#   비우면 KMA_SERVICE_KEY 를 대신 쓴다 — 한 계정 키로 여러 서비스가 열려
#   있는 경우가 흔해서다. 둘 다 비면 스텁으로 빠진다.
#   발급처가 사업자명을 필수로 받고 목록을 주는 오퍼레이션이 없어, 조회할
#   사업자를 아래에 적어 둔다. 한 번 조회에 사업자 수만큼 호출이 나간다.
PM_SERVICE_KEY=
PM_PROVIDERS=Beam,GCOO,SWING,씽씽,킥고잉,Lime,지쿠,알파카
PM_CACHE_TTL_SEC=120

# (5c) 카메라 인식 서비스 (yolo — WebSocket /ws/vision, compose `vision` 프로파일)
# VISION_GEMINI_API_KEY: 비워 두면 위 공용 GEMINI_API_KEY 를 그대로 쓴다.
#   agent 는 자기 호출량만 세어 일일 한도를 관리하므로, 같은 키를 카메라
#   인식이 나눠 쓰면 agent 가 한도 안이라고 믿는 상태에서 실제로는 거부당한다.
#   분리하려면 별도 키를 발급해 여기에 채운다.
# VISION_*_SECONDS: 카메라 인식 전용 타임아웃. agent 가 같은 이름의 키
#   (GEMINI_TIMEOUT_SECONDS · JOB_TIMEOUT_SECONDS)를 다른 값으로 쓰므로,
#   compose 가 yolo 에는 아래 VISION_* 값만 넣어 준다. 원본 이름을 .env 에
#   추가하면 agent 쪽 설정이 되고 yolo 에는 영향이 없다.
#   JOB 이 GEMINI 보다 커야 한다 — 같으면 식별을 마치고도 검색 도중 잘려
#   이미 얻은 결과가 통째로 버려진다.
# VISION_WS_MAX_JOBS: 연결 하나가 돌릴 수 있는 인식 횟수. 이 경로는 자체 인증이
#   없고 관문은 접속 시도만 막으므로, 상한이 없으면 연결 하나로 호출 한도를
#   소진해 일정 생성까지 함께 멈춘다.
VISION_GEMINI_API_KEY=
VISION_GEMINI_TIMEOUT_SECONDS=25.0
VISION_JOB_TIMEOUT_SECONDS=45.0
VISION_WS_MAX_JOBS=60

# (5d) 카메라 인식 모델 (yolo)
# YOLO_MODEL_PATH: 컨테이너 안 가중치 경로. 이미지에 내장되므로 보통 그대로 둔다.
# YOLO_CONFIDENCE: 탐지로 인정할 최소 신뢰도(0.0~1.0).
YOLO_MODEL_PATH=models/yolo11n.pt
YOLO_CONFIDENCE=0.5

# (5b) 경로 라우팅 (자체 호스팅 OSRM)
# 도보(foot)/자전거(bicycle) 프로파일 OSRM 인스턴스의 base URL.
# 비워 두면 hub 가 결정적 스텁 지오메트리로 폴백한다(데이터 빌드 전 검증용).
# scripts/osrm-rebuild.sh 로 데이터를 빌드하고
# `docker compose --profile routing up -d` 로 기동한 뒤 아래를 채우고 hub 재기동:
#   OSRM_FOOT_BASE_URL=http://osrm-foot:5000
#   OSRM_BICYCLE_BASE_URL=http://osrm-bicycle:5000
OSRM_FOOT_BASE_URL=
OSRM_BICYCLE_BASE_URL=

# (6) 모드·메타
# LANGGRAPH_SCHEMA: agent 체크포인터가 사용하는 Postgres 스키마명(app/agent_settings.py).
LANGGRAPH_SCHEMA=langgraph
# LOG_LEVEL: agent 루트 로거 레벨. 비우면 INFO. uvicorn 은 자기 로거만 설정하고
#            루트 로거에는 핸들러를 붙이지 않으므로, agent 가 부팅 시 루트 핸들러가
#            비어 있을 때만 stdout 핸들러를 붙여 app.* 로그를 살린다.
LOG_LEVEL=INFO

# (6a) agent 기능 스위치
# 장애가 나거나 추천 품질이 나빠졌을 때 재배포 없이 즉시 끄기 위한 값이다.
# 다섯 다 코드에 기본값 true 가 있어 비워 두어도 지금과 똑같이 동작하지만,
# 키가 여기 없으면 끌 방법 자체가 없다. 그래서 기본값을 그대로 적어 둔다.
#
# RULES_ENABLED: 이동수단 반경 필터와 실내 가점 랭킹. false 면 두 노드가
#   후보를 손대지 않고 그대로 통과시킨다.
# TIMELINE_ENABLED: 체류시간·방문 시각 계산. false 면 계산을 건너뛰어
#   시간축이 붙기 전과 같은 응답이 나간다.
# REVIEWS_ENRICH_ENABLED: 장소를 고르고 이유를 쓸 때 블로그 후기 스니펫을
#   근거로 붙이는 보강. false 면 후기 조회를 아예 하지 않는다.
# SUMMARY_ENABLED: 장소별 후기 요약. false 면 요약을 만들지 않고 빈 결과를
#   준다. 빈 결과는 부르는 쪽이 캐시하지 않으므로 되돌리면 바로 정상으로
#   돌아온다.
# PERSONALIZATION_ENABLED: 테마 친화 가점. false 면 가점을 0 으로 계산해
#   응답이 도입 전과 같아진다. 가점이 랭킹 노드 안에 있어 RULES_ENABLED 를
#   끄면 이것도 함께 꺼진다.
RULES_ENABLED=true
TIMELINE_ENABLED=true
REVIEWS_ENRICH_ENABLED=true
SUMMARY_ENABLED=true
PERSONALIZATION_ENABLED=true

# (6b) 동기 trip facade 타임아웃 (user-BFF)
# TRIP_POLL_TIMEOUT_SECONDS: BFF 가 agent draft 를 기다리는 상한(초).
#   대기 상한 순서는 client(180) > 터널(120) > BFF(본 값) > 통상 완료 시간이어야
#   한다. 터널이 사이에 있다는 점이 중요하다 — 퀵터널은 원본 응답을 120초까지만
#   기다리고 끊는다. 본 값이 그보다 크면, 서버가 아직 기다리는 중에 터널이 먼저
#   끊어 사용자에게는 사유 없는 실패로 보인다. 서버가 스스로 시간초과를 내려면
#   터널보다 짧아야 한다.
#   본 값이 client 보다 길면 client 가 버린 요청을 서버가 계속 폴링한다.
#   agent 쪽 잡 상한(JOB_TIMEOUT_SECONDS=300)은 별개로 더 길다.
#   터널을 쓰지 않는 곳에 올리면 다시 늘려도 된다.
TRIP_POLL_TIMEOUT_SECONDS=110

# (8) admin 운영 콘솔 (cut 2 — JSON API + SPA)
# MAP_ADMIN_PASSWORD 는 db/init/10-admin.sh 의 map_admin 역할 비밀번호이며,
# ADMIN_DATABASE_URL 의 비밀번호와 반드시 동일해야 한다(단일 출처).
MAP_ADMIN_PASSWORD=replace-with-map-admin-password
ADMIN_DATABASE_URL=postgresql+psycopg://map_admin:replace-with-map-admin-password@postgres:5432/map
# DB 조회 타임아웃(초).
DB_TIMEOUT_SEC=5.0

# 운영자 인증: admin_accounts(bcrypt) + 서버측 세션(HttpOnly 쿠키).
# [필수] admin_accounts 가 비어 있을 때만 아래 자격으로 최초 계정 1회 시드한다.
#        비워 두면 계정이 생성되지 않아 콘솔에 아무도 로그인할 수 없다.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-password
ADMIN_ENVIRONMENT=test
# Server-only per-environment connections; never put credentials in frontend config.
ADMIN_TARGETS={}
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOGIN_WINDOW_SECONDS=300

# 학습 파이프라인은 보류. 승인된 재개 전에는 캡처/Streams 학습발행을 끈다.
TRAINING_CAPTURE_ENABLED=false
VISION_INTERNAL_TOKEN=replace-with-dedicated-vision-permit-token
USER_SERVICE_BASE_URL=http://user:8080
VISION_PERMIT_TIMEOUT_SECONDS=5
VISION_MAX_CONCURRENT_JOBS=2
WS_IDLE_TIMEOUT_SECONDS=120
WS_MAX_MESSAGES_PER_CONNECTION=240
# 세션 수명(분). 기본 720 = 12시간.
ADMIN_SESSION_TTL_MIN=720
# HTTPS(터널/도메인) 배포 시 true, loopback 개발은 false.
#
# 서버에 올린 콘솔을 접속 통로로 볼 때는 false 로 둔다. 그 통로의 끝은
# 브라우저 쪽에서 평문 loopback 이라, true 로 두면 브라우저가 쿠키를 아예
# 저장하지 않아 로그인이 성공한 뒤에도 곧바로 튕긴다. 콘솔을 도메인 뒤에
# 세워 https 로 직접 열 때만 true 다.
ADMIN_SESSION_COOKIE_SECURE=false
# dev SPA(Vite) 교차출처 허용 목록. 프로덕션은 nginx same-origin 이라 쓰지 않는다.
# JSON 배열 복합 타입이라 `ADMIN_CORS_ORIGINS=` 처럼 빈 값을 남기면 admin 이
# SettingsError 로 뜨지 못한다. 안 쓸 때는 아래처럼 주석으로 둔다.
# ADMIN_CORS_ORIGINS=["http://localhost:5173"]
# Redis 진단 읽기전용(스트림·Gemini 쿼터·캐시 조회).
ADMIN_REDIS_URL=redis://redis:6379
# Grafana 패널 임베드 슬롯(JSON 배열). 키를 주석 처리하면 콘솔에서 모니터링 탭을 숨긴다.
# ADMIN_CORS_ORIGINS 와 같은 복합 타입이라 `MONITORING_PANELS=` 빈 값은 SettingsError 다.
# MONITORING_PANELS=[{"title":"개요","url":"http://127.0.0.1:3000/d/map-overview"}]
#
# 여기 적는 주소는 **보는 사람의 브라우저가 여는 주소**다. 콘솔이 대신
# 불러다 주는 것이 아니라 화면 안에 창을 하나 열어 그 주소로 직접 간다.
#
# 그래서 서버에 올린 것을 접속 통로로 볼 때는, 서버 안의 포트가 아니라
# 내 컴퓨터에서 통로가 열린 포트를 적어야 한다. 서버 안의 포트를 그대로
# 적으면 창만 빈 채로 뜨고, 어디가 잘못됐는지는 아무 데도 남지 않는다.

# (8.6) 모니터링 스택 (compose `monitoring` 프로파일)
# docker-compose.admin.yml 이 직접 참조하는 키다. Grafana 초기 관리자 자격과 노출 포트.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-strong-password
GRAFANA_PORT=3000

# (8.4) 후기 요약 (BFF) — 값은 전부 선택. 비우면 application.yml 기본값을 쓴다.
# SUMMARY_TTL_SECONDS: 요약 캐시 보관 시간(초).
# PREWARM_*: 일정 생성 직후 요약을 미리 만들어 두는 동작.
#            ENABLED 를 false 로 하면 요약은 화면에서 열 때만 만들어진다.
REVIEWS_SUMMARY_TTL_SECONDS=86400
REVIEWS_PREWARM_ENABLED=true
REVIEWS_PREWARM_POOL_SIZE=1
REVIEWS_PREWARM_QUEUE_CAPACITY=50
REVIEWS_PREWARM_MAX_PLACES=7
REVIEWS_PREWARM_BATCH_SIZE=7

# (8.5) 채팅 (경계 B8) — 상세 설정은 application.yml chat.* 기본값 사용
# CHAT_INVITE_BASE_URL: 초대 링크 기준 주소.
#                       경로는 앱 라우트(/invite/{토큰})와 같아야 한다 — 다르면
#                       링크를 눌러도 앱이 그 화면을 찾지 못한다.
#                       도메인은 앱 링크 검증 파일(assetlinks.json)을 올려 둔 곳과
#                       같아야 한다. 어긋나면 검증이 조용히 실패해 링크가 앱 대신
#                       브라우저로 열린다. 영구 호스트가 정해지면 이 값만 바꾸면 된다.
CHAT_INVITE_BASE_URL=https://mapcenter-b59ca.web.app/invite/
# CHAT_MAX_MESSAGE_LENGTH: 텍스트 메시지 최대 글자 수(초과 시 400 거부)
CHAT_MAX_MESSAGE_LENGTH=2000
# CHAT_INVITE_TTL_DAYS: 발급한 초대 링크가 며칠 뒤 스스로 만료되는지.
#                       방 만료와 별개이며 실제 유효기간은 둘 중 이른 쪽이다.
CHAT_INVITE_TTL_DAYS=7
# CHAT_INVITE_PREVIEW_RATE_LIMIT / _WINDOW_SECONDS:
#   초대 미리보기는 로그인 없이 호출할 수 있어 사용자 단위로 셀 수 없다.
#   발신 주소 기준으로 창당 몇 번까지 허용할지 정한다.
CHAT_INVITE_PREVIEW_RATE_LIMIT=30
CHAT_INVITE_PREVIEW_RATE_WINDOW_SECONDS=60

# (9) 보안 (CORS / 인증 강제)
# CORS_ALLOWED_ORIGINS: 운영 시 명시 도메인으로 제한
CORS_ALLOWED_ORIGINS=*
AUTH_ENFORCED=false

# (10) 테스터 계정 시더 (user BFF)
# TESTER_SEED_ENABLED=true 로 두면 user 가 부팅할 때마다
#   maptester1@admin.map ~ maptester5@admin.map 5개 계정을 보장한다.
#   없으면 만들고, 비밀번호가 표준값과 어긋나 있으면 되돌린다. 닉네임과 나머지
#   프로필은 만들 때만 넣고 이후 건드리지 않는다 — 내 정보 화면에서 바꾼 값이
#   부팅마다 되돌아가면 안 되기 때문이다.
#   데이터 볼륨을 지워도(compose down -v) 다시 띄우면 그대로 되살아난다.
#   기본 false. 운영에서는 켜지 않는다 — 비밀번호를 팀이 공유하는 계정이 5개 생긴다.
# TESTER_SEED_PASSWORD: 5개 계정 공통 비밀번호. 비워 두면 켜져 있어도 경고만 남기고
#   계정을 만들지 않는다(평문 비밀번호를 소스에 남기지 않으려고 기본값을 두지 않았다).
#   값을 바꾸면 다음 부팅에서 기존 5개 계정의 해시가 새 값으로 교체된다.
TESTER_SEED_ENABLED=false
TESTER_SEED_PASSWORD=

# ── 앞단(edge) — 바깥에서 부를 주소와 인증서 ─────────────────────────────
# docker-compose.edge.yml 을 함께 얹을 때만 쓴다. 얹지 않으면 없어도 된다.
#
# 네 값 모두 비워 두면 기동이 그 자리에서 멈춘다. 앞단이 주소를 모르는 채로
# 뜨면 인증서를 못 받고, 그때는 앱이 붙지 못하는 이유가 밖에서 보이지 않는다.
#
# EDGE_DOMAIN: 앞단이 인증서를 받을 주소. 운영과 시험이 다른 이름을 쓴다.
# EDGE_EMAIL: 인증서 만료 알림을 받을 주소.
# DUCKDNS_SUBDOMAIN: 동적 DNS 에 만든 이름(주소에서 .duckdns.org 앞부분).
# DUCKDNS_TOKEN: 그 계정의 발급 토큰. 토큰은 이름마다가 아니라 계정마다
#   하나라, 한 토큰으로 그 계정의 모든 이름을 바꿀 수 있다. 운영과 시험은
#   계정을 나눠 서로의 주소를 건드리지 못하게 한다.
EDGE_DOMAIN=
EDGE_EMAIL=
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# ── 이미지를 받아올 곳 ───────────────────────────────────────────────────
# docker-compose.registry.yml 을 함께 얹을 때만 쓴다. 만드는 일은 다른 곳에서
# 하고 여기서는 받기만 한다 — 서버에서는 빌드가 끝나지 않는다.
#
# IMAGE_TAG 를 비워 두면 받아오기가 그 자리에서 멈춘다. 그게 낫다. 비운 채로
# 떠 버리면 어느 코드가 도는지 서버 어디에도 적히지 않는다. 값은 이미지를
# 만든 실행이 알려 주는 것을 그대로 옮겨 적는다.
IMAGE_REGISTRY=ghcr.io/we-meet-trip
IMAGE_TAG=

# (5c) 성향별 저장 비율 통계 (선택)
# agent 가 후보 랭킹에 조금 얹는 값이다. 비우면 아무 일도 하지 않는다.
# 파일은 쌓인 세션에서 만들어 낸다(infra/segstats 에 두고 읽기 전용으로 붙인다).
SEGMENT_STATS_PATH=

# User serving uses a dedicated runtime login; owner/migrator secrets live only
# in the root-owned /etc/map-deploy/user-migration.env (three USER_MIGRATION_* keys).
USER_DATABASE_USER=map_user_runtime
USER_DATABASE_PASSWORD=replace-with-a-distinct-runtime-password

# Agent serving reads and writes only its own checkpoint schema. Its migrator
# DSN lives in the root-owned /etc/map-deploy/agent-migration.env, never here.
AGENT_DATABASE_USER=map_agent_runtime
AGENT_DATABASE_PASSWORD=replace-with-a-distinct-agent-runtime-password

# Metrics collection needs pg_monitor only; this login holds no table privileges.
POSTGRES_EXPORTER_DSN=postgresql://map_pg_exporter:replace-with-a-distinct-exporter-password@postgres:5432/map?sslmode=disable
APP_ENV=prod
KAKAO_PUBLIC_ORIGIN=https://api.example.invalid
